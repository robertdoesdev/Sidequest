# Copy to .env (never commit .env). Values below are placeholders.

# --- Database (required in production) ---------------------------------------
# Any PostgreSQL connection string. For Supabase use the *pooled* "Transaction" string
# (Project Settings > Database > Connection string), which suits serverless functions.
# Leave unset for local development: SideQuest then uses an embedded PostgreSQL under ./data/pg.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
PGPOOL_MAX=5

# --- Web Push (optional; background notifications stay OFF without these) ------
# Generate once:  node -e "import('./webpush.mjs').then(m=>{const v=m.generateVapid();console.log('VAPID_PUBLIC_KEY='+v.publicKey);console.log('VAPID_PRIVATE_KEY='+JSON.stringify(v.privateKey).slice(1,-1))})"
# The private key is a SECRET: server-side only, never in frontend code or git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.example

# Shared secret for the scheduled push endpoint (/api/cron/push). Vercel Cron sends it automatically
# when a CRON_SECRET env var exists. Use a long random string.
CRON_SECRET=

# --- Optional -------------------------------------------------------------------
# Only if the API is served from a different origin than the frontend:
SIDEQUEST_CORS_ORIGIN=
# Local server only:
PORT=3000
SIDEQUEST_DATA=./data
